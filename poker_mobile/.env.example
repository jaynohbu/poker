# Development environment variables for poker_mobile

# Web App URL (where Angular app runs)
# Development
REACT_APP_WEB_URL=http://localhost:4200

# Production
# REACT_APP_WEB_URL=https://poker.example.com

# API Base URL (NestJS backend)
# Development
REACT_APP_API_URL=http://localhost:3000

# Production
# REACT_APP_API_URL=https://api.poker.example.com

# ML Service URL
# Development
REACT_APP_ML_URL=http://localhost:5000

# Production
# REACT_APP_ML_URL=https://ml.poker.example.com

# Debug mode
DEBUG=true

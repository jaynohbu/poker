{
  "name": "poker-mobile",
  "version": "1.0.0",
  "description": "Poker Platform - React Native WebView for iOS/Android",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",

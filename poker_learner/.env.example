# Poker ML Service Configuration

# Flask API Settings
FLASK_PORT=5000
FLASK_DEBUG=false

# Database Connection
DATABASE_URL=mysql://user:password@localhost:3306/poker_db

# Model Configuration
MODEL_PATH=./models
DEFAULT_MODEL=self_play_v1

# Training Configuration
TRAINING_ENABLED=true
AUTO_RETRAIN_HOURS=24
TRAINING_BATCH_SIZE=64
TRAINING_LEARNING_RATE=0.0003

# RL Settings
RL_ALGORITHM=ppo
RL_TOTAL_TIMESTEPS=100000
RL_NUM_PARALLEL_ENVS=4

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/ml_service.log

# Performance
MODEL_CACHE_SIZE=5
INFERENCE_TIMEOUT_MS=500

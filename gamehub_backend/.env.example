# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=poker_user
DATABASE_PASSWORD=poker_password
DATABASE_NAME=poker_db
DATABASE_URL=mysql://poker_user:poker_password@localhost:3306/poker_db

# Backend Server
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:55123,http://localhost:4200

# DynamoDB
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_ENDPOINT=http://localhost:8000
ARTICLES_TABLE_NAME=gh_articles
DYNAMODB_INIT=false
DYNAMODB_SEED=false

# Blog Image Upload
BLOG_IMAGES_BUCKET=gh_blog_images
BLOG_IMAGES_REGION=ap-northeast-2

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=24h

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Frontend URLs
FRONTEND_URL=http://localhost:4200

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# ML Service
ML_SERVICE_URL=http://localhost:5000

# Game Configuration
MIN_PLAYERS=2
MAX_PLAYERS=6
SMALL_BLIND=1
BIG_BLIND=2
STARTING_CHIPS=1000

# WebSocket
WEBSOCKET_CORS=http://localhost:4200,http://localhost:3000

# Logging
LOG_LEVEL=debug
